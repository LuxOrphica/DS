{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin-new.html" },
    { "source": "/admin-legacy", "destination": "/admin.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
