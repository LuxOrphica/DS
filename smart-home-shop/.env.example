# Server
PORT=3030
TRUST_PROXY=1
API_BODY_LIMIT=1mb

# Admin API auth
# Required for /api/admin/* unless DISABLE_ADMIN_AUTH=1
ADMIN_TOKEN=1
DISABLE_ADMIN_AUTH=0
ADMIN_SESSION_TIMEOUT_MS=1800000

# CORS
# Comma-separated list.
# In production mode (`NODE_ENV=production`) empty list means cross-origin browser requests are blocked.
CORS_ALLOWED_ORIGINS=http://localhost:3030

# CSP
# 0 = enforce CSP headers, 1 = report-only mode
CSP_REPORT_ONLY=0

# API rate limiting (all /api/*)
API_RATE_LIMIT_MAX=240
API_RATE_LIMIT_WINDOW_MS=60000

# Public order lookup throttling
PUBLIC_LOOKUP_RATE_LIMIT=20
PUBLIC_LOOKUP_WINDOW_MS=60000

# HTTP server timeouts
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
