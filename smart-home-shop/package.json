{
  "name": "smart-home-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Local MVP online store for smart home equipment",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start_server_safe.js",
    "dev": "node --watch server.js",
    "lint": "node scripts/lint_syntax.js",
    "lint:eslint": "eslint . --max-warnings=0",
    "test": "npm run test:unit && npm run test:node",
    "test:node": "node --test --test-concurrency=1",
    "test:unit": "vitest run",
    "test:unit:report": "vitest run --reporter=default --reporter=junit --outputFile=reports/vitest.junit.xml",
    "test:unit:allure": "vitest run --reporter=default --reporter=allure-vitest/reporter",
    "test:report": "node --test --test-concurrency=1 --test-reporter=junit --test-reporter-destination=reports/test-results.junit.xml",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run encoding:check && npm run lint && npm run lint:eslint && npm run lint:ox && npm run typecheck && npm test",
    "release:gate": "npm run verify && npm run security:audit && npm run audit:catalog",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "encoding:check": "node scripts/encoding-hygiene.js",
    "encoding:fix": "node scripts/encoding-hygiene.js --write",
    "check:encoding-ui": "powershell -ExecutionPolicy Bypass -File scripts/check-encoding-and-ui.ps1",
    "encoding:check:legacy": "node scripts/encoding-hygiene.js --include-legacy-data",
    "encoding:fix:legacy": "node scripts/encoding-hygiene.js --include-legacy-data --write",
    "data:fix-artifacts": "node scripts/fix_known_catalog_artifacts.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "audit:quality": "node scripts/audit_catalog_quality.js",
    "audit:scripts": "node scripts/audit_scripts_inventory.js",
    "audit:admin-ui": "node scripts/audit_admin_ui.js",
    "clean:quality": "node scripts/clean_catalog_quality.js --write",
    "db:init": "node scripts/init_db.js",
    "import:simpleled": "node scripts/import_simpleled_catalog.js",
    "db:import:simpleled": "node scripts/import_simpleled_to_db.js",
    "db:enrich:simpleled": "node scripts/enrich_simpleled_product_details.js 1000",
    "db:enrich:simpleled:all": "node scripts/enrich_simpleled_product_details.js 5000 --all",
    "images:retouch:dry": "node scripts/ai_retouch_product_images.js 20 --dry-run",
    "images:retouch": "node scripts/ai_retouch_product_images.js 20",
    "images:mirror-local": "node scripts/mirror_product_images_local.js",
    "images:recover:wb-wiki": "node scripts/recover_wirenboard_images_from_wiki.js",
    "images:recover:wb-antennas": "node scripts/recover_wb_antennas_from_wiki.js",
    "images:fill:wb-placeholders": "node scripts/fill_missing_wb_images_with_local_placeholders.js",
    "db:recategorize:functional": "node scripts/auto_recategorize_functional_catalog.js",
    "db:recategorize:functional:apply": "node scripts/auto_recategorize_functional_catalog.js --apply",
    "db:normalize:catalog": "node scripts/normalize_catalog_attributes.js",
    "audit:catalog": "node scripts/audit_catalog_integrity.js",
    "snapshot:catalog": "node scripts/catalog_golden_snapshot.js",
    "snapshot:catalog:update": "node scripts/catalog_golden_snapshot.js --update",
    "assets:og": "node scripts/generate_og_image.js",
    "test:golden": "node --test test/catalog-golden.test.js",
    "audit:all": "npm run audit:catalog && npm run audit:quality && npm run security:audit",
    "clean:data": "node scripts/clean_data.js",
    "import:new-structure": "node scripts/import_new_structure.js",
    "import:advanced": "node scripts/import_advanced.js",
    "import:hite-pro": "node scripts/import_hite_pro_blocks.js",
    "update:shop": "node scripts/update_shop.js",
    "import:with-images": "node scripts/import_with_images.js",
    "import:hite-full": "node scripts/sync_hite_catalog.js",
    "import:hite-shop-live": "node scripts/sync_hite_shop_live.js",
    "import:loxone-smart-port-live": "node scripts/sync_loxone_smart_port_live.js",
    "import:wirenboard-live": "node scripts/sync_wirenboard_live.js",
    "update:shop-advanced": "node scripts/update_shop_advanced.js",
    "sync:brand-native-to-db": "node scripts/sync_brand_native_categories_to_db.js",
    "lint:ox": "oxlint . --ignore-path .gitignore --quiet"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@sentry/node": "^10.53.1",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-vitest": "^3.9.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "oxlint": "^1.66.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
