{
  "name": "smart-home-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Local MVP online store for smart home equipment",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start_server_safe.js",
    "dev": "node --watch server.js",
    "lint": "node scripts/lint_syntax.js",
    "test": "node --test",
    "verify": "npm run encoding:check && npm run lint && npm test",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "encoding:check": "node scripts/encoding-hygiene.js",
    "encoding:fix": "node scripts/encoding-hygiene.js --write",
    "encoding:check:legacy": "node scripts/encoding-hygiene.js --include-legacy-data",
    "encoding:fix:legacy": "node scripts/encoding-hygiene.js --include-legacy-data --write",
    "data:fix-artifacts": "node scripts/fix_known_catalog_artifacts.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "audit:quality": "node scripts/audit_catalog_quality.js",
    "audit:scripts": "node scripts/audit_scripts_inventory.js",
    "clean:quality": "node scripts/clean_catalog_quality.js --write",
    "db:init": "node scripts/init_db.js",
    "import:simpleled": "node scripts/import_simpleled_catalog.js",
    "db:import:simpleled": "node scripts/import_simpleled_to_db.js",
    "db:enrich:simpleled": "node scripts/enrich_simpleled_product_details.js 1000",
    "db:enrich:simpleled:all": "node scripts/enrich_simpleled_product_details.js 5000 --all",
    "images:retouch:dry": "node scripts/ai_retouch_product_images.js 20 --dry-run",
    "images:retouch": "node scripts/ai_retouch_product_images.js 20",
    "db:normalize:catalog": "node scripts/normalize_catalog_attributes.js",
    "audit:catalog": "node scripts/audit_catalog_integrity.js",
    "clean:data": "node scripts/clean_data.js",
    "import:new-structure": "node scripts/import_new_structure.js",
    "import:advanced": "node scripts/import_advanced.js",
    "import:hite-pro": "node scripts/import_hite_pro_blocks.js",
    "update:shop": "node scripts/update_shop.js",
    "import:with-images": "node scripts/import_with_images.js",
    "import:hite-full": "node scripts/sync_hite_catalog.js",
    "import:hite-shop-live": "node scripts/sync_hite_shop_live.js",
    "import:loxone-smart-port-live": "node scripts/sync_loxone_smart_port_live.js",
    "import:wirenboard-live": "node scripts/sync_wirenboard_live.js",
    "update:shop-advanced": "node scripts/update_shop_advanced.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
